# Copy this file to .env and fill in your values

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=chat-lc-lite
LANGSMITH_WORKSPACE_ID=your-demo-workspace-id
# Tagged onto every root run so traces can be filtered by environment.
# Set to "production" in deployed environments.
CHAT_LANGCHAIN_LITE_ENV=development

DEMO_PRESENTER="robert"